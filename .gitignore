# 框架核心目录（不建议提交）
#vendor/
#thinkphp/

# 应用运行时生成的文件
runtime/
*.log
*.tmp
*.pid
*.temp

# 本地配置文件（包含数据库密码等敏感信息）
#.env
#application/database.php
#application/config.php

# IDE 和编辑器的配置文件
.idea/
.vscode/
*.swp
*.swo
*~

# 操作系统自动生成的文件
.DS_Store
Thumbs.db

# Composer 临时文件
composer.lock
.phpunit.result.cache

# 上传文件目录（用户上传的资源不提交）
public/uploads/